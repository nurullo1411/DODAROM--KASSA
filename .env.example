# Postgres connection string. Format: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
# Neon: dashboard "Connection string" -> "Pooled connection"
# Supabase: Project Settings -> Database -> Connection pooling -> URI
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Strong random string. Production'da .auth-secret-prod.txt'dan oling yoki yangi generatsiya qiling.
# PowerShell: [Convert]::ToBase64String((New-Object byte[] 48 | %{ [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($_); $_ }))
AUTH_SECRET="dev-secret-replace-in-prod-12345-abcdef-very-long-string"
